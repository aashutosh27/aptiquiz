{
  "name": "aptiquiz",
  "version": "1.0.0",
  "description": "Real-time multiplayer aptitude quiz platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim:50": "node scripts/simulate-50.js",
    "sim:rooms": "node scripts/simulate-rooms.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "vitest": "^3.0.5"
  }
}
